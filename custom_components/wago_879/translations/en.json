  "exceptions": {
    "link_settings_clash": {
      "message": "Another integration already uses the meter's address with different link settings: {error}"
    },
    "meter_not_answering": {
      "message": "The meter at {host} did not answer: {error}"
    },
    "serial_mismatch": {
      "message": "The meter at {host} answers as serial {found}, but this entry belongs to serial {expected}. Point the entry at the address of meter {expected} with Reconfigure, or add meter {found} as its own entry."
    },
    "yaml_still_active": {
      "message": "{entity_id} is still served by the YAML modbus configuration. Remove the modbus: block for this meter, restart, then set up again."
    },
    "unique_id_taken": {
      "message": "Cannot move {entity_id} to {unique_id}: that unique id is already registered as {held_by}. Remove {held_by} first."
    },
    "removed_entry_in_the_way": {
      "message": "Cannot keep {entity_id}: a removed entry for {unique_id} would be restored as {restored}. Purge that removed entry before setting up this meter."
    },
    "entity_id_taken": {
      "message": "Could not keep {entity_id}: the registry gave {created}. Remove the stale entity holding that id."
    },
    "read_timed_out": {
      "message": "Modbus read timed out after {seconds}s"
    },
    "read_failed": {
      "message": "Modbus read failed: {error}"
    }
  },
  "issues": {
    "yaml_still_active": {
      "title": "The YAML modbus block still serves this meter",
      "description": "{entity_id} is still served by the YAML `modbus:` configuration, so its history cannot move to this integration yet.\n\nRemove the `modbus:` block for this meter from your configuration and restart Home Assistant. The integration then takes the entity ids over by itself."
    },
    "unique_id_taken": {
      "title": "A meter entity is in the way of the migration",
      "description": "{entity_id} cannot move to {unique_id}: that unique id is already registered as {held_by}.\n\nRemove {held_by} under Settings -> Entities. The integration retries on its own."
    },
    "removed_entry_in_the_way": {
      "title": "A deleted entity is in the way of the migration",
      "description": "{entity_id} cannot be kept: a deleted entry for {unique_id} would come back as {restored}.\n\nPurge that deleted entry, then reload the integration."
    },
    "entity_id_taken": {
      "title": "An entity id could not be kept",
      "description": "{entity_id} could not be kept: the registry gave {created}.\n\nRemove the stale entity holding {entity_id}, then reload the integration."
    }
  }
}
