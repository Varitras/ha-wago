  "exceptions": {
    "link_settings_clash": {
      "message": "Eine andere Integration nutzt die Adresse des Zählers bereits mit anderen Verbindungseinstellungen: {error}"
    },
    "meter_not_answering": {
      "message": "Der Zähler unter {host} hat nicht geantwortet: {error}"
    },
    "serial_mismatch": {
      "message": "Der Zähler unter {host} meldet die Seriennummer {found}, dieser Eintrag gehört aber zur Seriennummer {expected}. Richte den Eintrag mit „Neu konfigurieren“ auf die Adresse von Zähler {expected}, oder füge Zähler {found} als eigenen Eintrag hinzu."
    },
    "yaml_still_active": {
      "message": "{entity_id} wird noch von der YAML-Modbus-Konfiguration bereitgestellt. Entferne den modbus:-Block für diesen Zähler, starte neu und richte die Integration dann erneut ein."
    },
    "unique_id_taken": {
      "message": "{entity_id} kann nicht nach {unique_id} verschoben werden: Diese Unique-ID ist bereits als {held_by} registriert. Entferne zuerst {held_by}."
    },
    "removed_entry_in_the_way": {
      "message": "{entity_id} kann nicht übernommen werden: Ein gelöschter Eintrag für {unique_id} würde als {restored} wiederhergestellt. Entferne diesen gelöschten Eintrag endgültig, bevor du den Zähler einrichtest."
    },
    "entity_id_taken": {
      "message": "{entity_id} konnte nicht übernommen werden: Die Registry vergab {created}. Entferne die veraltete Entität, die diese ID belegt."
    },
    "read_timed_out": {
      "message": "{poller}: Modbus-Lesezugriff nach {seconds}s abgebrochen"
    },
    "read_failed": {
      "message": "{poller}: Modbus-Lesezugriff fehlgeschlagen: {error}"
    }
  },
  "issues": {
    "yaml_still_active": {
      "title": "Der YAML-Modbus-Block bedient diesen Zähler noch",
      "description": "{entity_id} wird noch von der YAML-Konfiguration `modbus:` bereitgestellt, deshalb kann die Historie noch nicht in diese Integration übernommen werden.\n\nEntferne den `modbus:`-Block für diesen Zähler aus der Konfiguration und starte Home Assistant neu. Danach übernimmt die Integration die Entitäts-IDs selbst."
    },
    "unique_id_taken": {
      "title": "Eine Zähler-Entität blockiert die Übernahme",
      "description": "{entity_id} kann nicht nach {unique_id} verschoben werden: Diese Unique-ID ist bereits als {held_by} registriert.\n\nEntferne {held_by} unter Einstellungen -> Entitäten. Die Integration versucht es danach selbst erneut."
    },
    "removed_entry_in_the_way": {
      "title": "Eine gelöschte Entität blockiert die Übernahme",
      "description": "{entity_id} kann nicht übernommen werden: Ein gelöschter Eintrag für {unique_id} käme als {restored} zurück.\n\nEntferne diesen gelöschten Eintrag endgültig und lade die Integration neu."
    },
    "entity_id_taken": {
      "title": "Eine Entitäts-ID konnte nicht übernommen werden",
      "description": "{entity_id} konnte nicht übernommen werden: Die Registry vergab {created}.\n\nEntferne die veraltete Entität, die {entity_id} belegt, und lade die Integration neu."
    }
  }
}
